# Generated: ability, passive, feat and skill text for the menus.
data modify storage ch:const menu set value {"rage": {"title": "Rage", "color": "#E0262B", "lore": "Fury given form. It grows stronger the longer the fight lasts.", "i": 1, "a": [{"name": "Rage Leap", "desc": "Leap and slam down where you land: damage falls off from the centre and everything is launched. A red circle shows where you will land.", "var": "Level: long arcing leap (longer and lower while moving forward). Up: Skyfall, rocket up, hang while a sigil marks the ground, then dive; +0.5 damage per block fallen. Down: Earthsplitter, a fissure tears 11 blocks forward and throws everything on it into the air.", "cd": 10, "unlock": 0}, {"name": "War Cry", "desc": "Draw breath, then roar: Weakness on everything near you and Strength for you. With 30 Fury it is spent for a roar that also wounds, staggers and slows.", "var": "Level: the inhaled roar (a collapsing ring warns enemies). Up: Blood Challenge, a war horn that drags enemies in and marks them; their blows on you feed double Fury. Down: Blood Oath, tear your own heart for 1.5 hearts: 40 Fury and Strength at once.", "cd": 25, "unlock": 10}, {"name": "Berserk Chain", "desc": "Your next 3 melee hits deal bonus damage and send out shockwaves that grow with every link; the last one shatters the ground and stuns.", "var": "Level: the chain. Up: Retaliation, a 5 s stance: up to 4 blows you take erupt back at everyone near you, stronger with Fury. Down: Ravage, three whirling cleaves that drag enemies in, then hurl them away.", "cd": 30, "unlock": 40}, {"name": "Rampage", "desc": "Become fury itself for 10 s: Speed II, Strength II, Resistance and 15% melee lifesteal. Kills extend it.", "var": "Level: Rampage. Up: Wrathfall, rocket skyward and crash down as a meteor, then Rampage for 7 s. Down: Blood for Blood, no Resistance, but every blow you take is lashed back at the attacker, pain feeds double Fury and lifesteal rises to 25%.", "cd": 120, "unlock": 75}], "p1": "Fury", "p1d": "Rage feeds on pain. Taking damage builds Fury fast (faster below half health); dealing it builds Fury too. At 50+ Fury your melee hits deal 10% more. Fury drains after 4 s out of combat.", "p2": "Bloodlust", "p2d": "Reaching full Fury grants Strength I for 6 seconds.", "aw": "Wrath Incarnate", "awd": "Fury can reach 150. Above 100 Fury you burn with black flame and take less damage.", "feats": [{"name": "Earthshaker", "desc": "Hit 3 enemies with a single Rage Leap", "xp": 400}, {"name": "Unchained", "desc": "Reach maximum Fury 10 times", "xp": 300}, {"name": "Battle Hymn", "desc": "Weaken 5 enemies with one War Cry", "xp": 500}, {"name": "Last Stand", "desc": "Kill a player during Rampage while below 3 hearts", "xp": 800}], "br": [{"name": "Butcher", "desc": "Raw damage", "n": [{"name": "Heavy Landing", "desc": "+20% Rage Leap damage"}, {"name": "Bloodied Edge", "desc": "+25% Berserk Chain damage"}, {"name": "Cleave", "desc": "+40% Berserk shockwave radius"}, {"name": "Executioner", "desc": "Melee hits deal +15% to targets below 30% health"}, {"name": "Avalanche", "desc": "CAPSTONE: Rage Leap can be recast for free within 3 seconds of landing"}]}, {"name": "Juggernaut", "desc": "Survive anything", "n": [{"name": "Thick Skin", "desc": "Take 8% less damage while at 50+ Fury"}, {"name": "Pain Fuels Me", "desc": "Taking damage grants twice the Fury"}, {"name": "Unstoppable", "desc": "+30% Rampage duration"}, {"name": "Iron Will", "desc": "War Cry also grants Resistance I"}, {"name": "Undying Rage", "desc": "CAPSTONE: once every 2 minutes, lethal damage leaves you at 2 hearts and starts a short Rampage"}]}, {"name": "Warlord", "desc": "Lead the charge", "n": [{"name": "Rallying Roar", "desc": "+30% War Cry radius"}, {"name": "Shared Fury", "desc": "War Cry gives teammates Strength I"}, {"name": "Momentum", "desc": "Rage Leap recharges 25% faster"}, {"name": "Fury Engine", "desc": "Rage Leap slams grant 25 Fury"}, {"name": "Warlord's Banner", "desc": "CAPSTONE: War Cry plants a banner for 8s: teammates inside regenerate, enemies inside are weakened"}]}]}, "speed": {"title": "Speed", "color": "#F5E142", "lore": "A heart that never stops racing. Time bends around it.", "i": 2, "a": [{"name": "Dash", "desc": "Tear through space in a streak of light. Everything you pass through is cut.", "var": "Level: an 8-block blink that cuts everyone in your path. Up: Rising Rend, a diagonal cut that throws them into the air while you float. Down: Recoil, dash backward and leave a ticking slash sigil that detonates where you stood.", "cd": 6, "unlock": 0}, {"name": "Afterimage", "desc": "Vanish completely, armour and all (you keep its protection), leaving a decoy with your face. Taking a hit or attacking reveals you.", "var": "Level: vanish behind a decoy. Up: Mirror Feint, the decoy sprints ahead and explodes in a blinding flash. Down: Shade Ambush, your first strike from hiding roots the target and echoes as a sonic boom.", "cd": 20, "unlock": 10}, {"name": "Slipstream", "desc": "Surge into the slipstream. Your wake trails behind you and punishes anyone who crosses it.", "var": "Level: Speed III and a wake that slows. Up: Afterburner, rocket along your look and leave a burning, crackling wake. Down: Vortex Lap, a cyclone circles you, drags enemies into orbit and flings them out when it ends.", "cd": 30, "unlock": 40}, {"name": "Time Fracture", "desc": "Shatter the clock. Inside the fracture enemies crawl, arrows hang in the air and ability projectiles creep; you move freely.", "var": "Level: a 12-block stasis field where you stand. Up: Chrono Collapse, a smaller field that implodes and charges every caught enemy for the time they spent inside (get out!). Down: Moment Shell, the field rides with you.", "cd": 120, "unlock": 75}], "p1": "Swift", "p1d": "You move 15% faster at all times.", "p2": "Momentum", "p2d": "Sprint for 3 seconds to charge Momentum (shown on the meter). Your next melee hit blasts them away, and its sonic boom lands half a second later for +4 damage.", "aw": "Lightspeed", "awd": "Dash recharges twice as fast and leaves a cyan lightning streak; sprinting leaves a crackling electric trail.", "feats": [{"name": "Blink Strike", "desc": "Kill an enemy within 3 seconds of a Dash", "xp": 400}, {"name": "Afterburner", "desc": "Travel 2,000 blocks inside Slipstream", "xp": 500}, {"name": "Stopped Clock", "desc": "Catch 3 enemies in one Time Fracture", "xp": 500}, {"name": "Unstoppable Force", "desc": "Land 25 Momentum strikes", "xp": 300}], "br": [{"name": "Blitz", "desc": "Cut through them", "n": [{"name": "Sharpened Wind", "desc": "+25% Dash damage"}, {"name": "Long Stride", "desc": "+30% Dash distance"}, {"name": "Follow-Through", "desc": "Hitting an enemy with Dash refunds 30% of its cooldown"}, {"name": "Momentum Overload", "desc": "+60% Momentum strike damage"}, {"name": "Thousand Cuts", "desc": "CAPSTONE: Dash leaves slashes along its path that strike again half a second later"}]}, {"name": "Phantom", "desc": "Never be where they aim", "n": [{"name": "Lingering Shade", "desc": "+40% Afterimage invisibility"}, {"name": "Decoy Burst", "desc": "The decoy bursts when it fades, slowing nearby enemies"}, {"name": "Slippery", "desc": "Take 10% less damage while sprinting"}, {"name": "Ghost Step", "desc": "Afterimage recharges 25% faster"}, {"name": "Phase Runner", "desc": "CAPSTONE: during Slipstream a quarter of attacks against you miss"}]}, {"name": "Chronomancer", "desc": "Own the clock", "n": [{"name": "Wider Wake", "desc": "+40% Slipstream wake width"}, {"name": "Tailwind", "desc": "Slipstream gives teammates Speed II"}, {"name": "Extended Moment", "desc": "+30% Time Fracture duration"}, {"name": "Broken Clock", "desc": "+25% Time Fracture radius"}, {"name": "Rewind", "desc": "CAPSTONE: when Time Fracture ends you snap back to where you cast it and recover the health you lost"}]}]}, "infernal": {"title": "Infernal", "color": "#FF7A1A", "lore": "Forged in the deepest lava. It burns everything it touches.", "i": 3, "a": [{"name": "Fireball Volley", "desc": "Hurl three fireballs (5 damage each) that burst and set targets alight. Every Infernal hit builds Heat, the meter under your abilities. At 100 Heat your next ability is Overheated: +40% damage in a white-hot flash.", "var": "Level: a fan of three fireballs (five with Extra Fuel; the last is a meteor with Meteor). Up: Mortar, shells arc high and crash down in fiery bursts. Down: Pinwheel, embers spin out around you in a ring and seek out nearby foes.", "cd": 8, "unlock": 0}, {"name": "Flame Wall", "desc": "Raise a wall of fire that burns enemies standing in it and incinerates projectiles that pass through.", "var": "Level: a wall across your path (a ring around you with Ring of Fire). Up: Marching Tide, a wave of flame rolls forward and shoves enemies back. Down: Burning Lane, a long strip of fire stretches ahead of you.", "cd": 22, "unlock": 10}, {"name": "Magma Eruption", "desc": "Mark the ground. A second later it erupts in a geyser of magma that hurls enemies into the air and sets them on fire.", "var": "Level: the geyser where you aim. Moving: a fissure races ahead of you and erupts in a chain. Up: Molten Bombs, globs of magma fall on enemies around you. Down: Volcanic Leap, the ground erupts beneath you and throws you skyward.", "cd": 28, "unlock": 40}, {"name": "Inferno Avatar", "desc": "Become a living blaze for 10 s, with a burning aura and fireballs that seek your foes.", "var": "Level: the Avatar form. Up: Ascendant, rise and hover while fire rains down twice as fast. Down: Supernova, a 1.5 s charge that detonates in a huge 14-damage blast around you.", "cd": 120, "unlock": 75}], "p1": "Fireproof", "p1d": "Permanent Fire Resistance.", "p2": "Searing", "p2d": "Your melee hits sear: they set enemies on fire and build Heat.", "aw": "Hellfire", "awd": "Your flames turn into blue soul fire and deal 1 extra damage per second to burning enemies.", "feats": [{"name": "Cremation", "desc": "Kill 20 enemies while they burn", "xp": 400}, {"name": "Triple Threat", "desc": "Hit one target with every fireball of a Volley", "xp": 300}, {"name": "Firewall", "desc": "Incinerate 10 projectiles with Flame Wall", "xp": 400}, {"name": "Living Inferno", "desc": "Get 3 kills during one Inferno Avatar", "xp": 700}], "br": [{"name": "Pyromancer", "desc": "Rain fire", "n": [{"name": "Hotter Cores", "desc": "+20% fireball damage"}, {"name": "Extra Fuel", "desc": "Volley throws 5 fireballs"}, {"name": "Seeking Flame", "desc": "Fireballs curve toward the enemy you aim at"}, {"name": "Scorch", "desc": "Burning enemies take 15% more ability damage from you"}, {"name": "Meteor", "desc": "CAPSTONE: the last fireball of each Volley is a meteor that explodes in a 3-block blast"}]}, {"name": "Flamewarden", "desc": "Control the battlefield", "n": [{"name": "Wider Wall", "desc": "+40% Flame Wall width"}, {"name": "Lingering Heat", "desc": "+40% Flame Wall duration"}, {"name": "Cinder Shield", "desc": "Standing near your Flame Wall grants Resistance I"}, {"name": "Magma Surge", "desc": "+30% Magma Eruption radius"}, {"name": "Ring of Fire", "desc": "CAPSTONE: Flame Wall becomes a full ring of fire around you"}]}, {"name": "Ashbringer", "desc": "Burn bright, burn long", "n": [{"name": "Kindling", "desc": "Your melee burns last twice as long"}, {"name": "Phoenix Ember", "desc": "Heal 1 heart when an enemy you set alight dies"}, {"name": "Bigger Blaze", "desc": "+30% Inferno Avatar aura radius"}, {"name": "Endless Pyre", "desc": "Kills during Inferno Avatar extend it by 2 seconds"}, {"name": "Phoenix", "desc": "CAPSTONE: once every 3 minutes, lethal damage makes you explode in flame and rise with 6 hearts"}]}]}, "void": {"title": "Void", "color": "#8A3CFF", "lore": "A hole in the world, beating. Space folds at its will.", "i": 4, "a": [{"name": "Void Step", "desc": "Fold space and step out somewhere else. Aim at an enemy and you step out behind its back.", "var": "Level: step up to 14 blocks where you look, or behind the enemy you aim at. Up: rise 9 blocks and drift down; the hole you leave collapses a moment later, crushing whoever stands in it. Down: fold 9 blocks backwards; a black echo of you stays behind and detonates after a second.", "cd": 8, "unlock": 0}, {"name": "Rift Orb", "desc": "A slow orb of nothing that drags enemies into it and implodes.", "var": "Level: the orb drifts forward for 3 s, pulling everything within 5 blocks and stinging what touches it. Up: it races ahead, anchors, lifts enemies into the air and slams them into the ground. Down: a near-invisible rift mine; when an enemy comes close it swells and violently implodes.", "cd": 20, "unlock": 10}, {"name": "Displace", "desc": "Reach through the void at a target up to 20 blocks away and leave it lost in darkness.", "var": "Level: swap places with the target (Oblivion: hurl it into the sky instead). Up: rip the target through a rift to your feet and root it. Down: swap, and a rift under its new spot collapses after 1.5 s unless it gets out.", "cd": 30, "unlock": 40}, {"name": "Singularity", "desc": "Open a black hole that swallows everything around it, then collapses in a blinding shockwave.", "var": "Level: opens where you look and pulls for 6 s; the last second shrieks a warning before the collapse. Up: Crown of Nothing - it hovers over your head and follows you while you fight in its eye. Down: the void folds in at once - a 1.5 s windup, then everything within 12 blocks is yanked in and crushed.", "cd": 140, "unlock": 75}], "p1": "Phase", "p1d": "Incoming arrows, tridents and ability projectiles have a 15% chance to pass straight through you.", "p2": "Null Touch", "p2d": "Melee hits shroud enemies in Darkness for 3 s.", "aw": "Event Horizon", "awd": "Void Step leaves a rift open where you stood for 5 seconds; cast it again to return through it.", "feats": [{"name": "Wanderer of Nothing", "desc": "Travel 1,000 blocks with Void Step", "xp": 300}, {"name": "Gravity Well", "desc": "Pull 3 enemies into a single Rift Orb", "xp": 400}, {"name": "Switcheroo", "desc": "Kill an enemy within 5 seconds of Displacing them", "xp": 500}, {"name": "Event Horizon", "desc": "Catch 4 enemies in one Singularity", "xp": 800}], "br": [{"name": "Voidwalker", "desc": "Be everywhere", "n": [{"name": "Far Reach", "desc": "+30% Void Step range"}, {"name": "Quick Fold", "desc": "Void Step recharges 25% faster"}, {"name": "Shadow Wake", "desc": "Enemies near where you vanish are blinded"}, {"name": "Ambush", "desc": "Your first melee hit within 2s of a Void Step deals +50%"}, {"name": "Null Dash", "desc": "CAPSTONE: Void Step tears through enemies on the way for 5 damage"}]}, {"name": "Gravity", "desc": "Everything falls inward", "n": [{"name": "Dense Core", "desc": "+40% Rift Orb pull"}, {"name": "Crushing Weight", "desc": "+30% Rift Orb damage"}, {"name": "Wider Horizon", "desc": "+25% Singularity radius"}, {"name": "Lingering Pull", "desc": "Rift Orb lasts 50% longer"}, {"name": "Collapse", "desc": "CAPSTONE: Rift Orb ends by collapsing into a miniature Singularity"}]}, {"name": "Null", "desc": "Unmake them", "n": [{"name": "Deep Dark", "desc": "Null Touch Darkness lasts twice as long"}, {"name": "Unravel", "desc": "Displace also weakens the target"}, {"name": "Slippery Space", "desc": "Phase chance doubled to 30%"}, {"name": "Erasure", "desc": "Abilities deal +20% to enemies in Darkness"}, {"name": "Oblivion", "desc": "CAPSTONE: Displace hurls the target high into the sky instead of swapping"}]}]}, "frozen": {"title": "Frozen", "color": "#9BE7FF", "lore": "So cold it hurts to hold. It stills blood and breath.", "i": 5, "a": [{"name": "Ice Shard", "desc": "Fire a shard of ice (5 damage) that chills and stacks Frostbite. Frozen hits fill Frost, the meter under your abilities. At 100 Frost your shard becomes a piercing Glacial Lance (11 damage).", "var": "Level: a piercing shard (a fan of three with Hailstorm). Up: Icicle Rain, icicles fall onto the area you look at after a warning. Down: Frost Step, dash back and leave an ice decoy that explodes.", "cd": 5, "unlock": 0}, {"name": "Glacial Wall", "desc": "Raise a wall of solid ice that blocks enemies and projectiles, then melts after 8 s.", "var": "Level: a wall of ice ahead of you. Up: Glacier Ram, a moving wall that bulldozes forward and slams enemies. Down: Frozen Bastion, a ring of ice pillars around you and Resistance II.", "cd": 20, "unlock": 10}, {"name": "Frost Nova", "desc": "Release a burst of frost that freezes everything around you solid.", "var": "Level: an instant 6-block nova. Up: leap and crash down in a bigger 8-block nova. Down: Glacial Implosion, a collapsing ring drags enemies in for 1 s, then freezes them solid.", "cd": 25, "unlock": 40}, {"name": "Absolute Zero", "desc": "Call a blizzard that slows, chills and freezes enemies while ice spikes erupt beneath them.", "var": "Level: a 10-block blizzard where you stand. Up: Eye of the Storm, a tighter blizzard that travels with you. Down: Shatterpoint, freeze everything within 12 blocks solid, then shatter them all at once for 12 damage.", "cd": 130, "unlock": 75}], "p1": "Coldborn", "p1d": "You never freeze in powder snow, and water freezes into ice beneath your feet.", "p2": "Frostbite", "p2d": "Melee hits stack Frostbite. At 5 stacks the target freezes solid.", "aw": "Permafrost", "awd": "Frozen enemies shatter when your abilities hit them and take 40% more damage.", "feats": [{"name": "Deep Freeze", "desc": "Fully freeze 10 enemies with Frostbite", "xp": 400}, {"name": "Shard Sniper", "desc": "Hit an Ice Shard from 30 or more blocks away", "xp": 400}, {"name": "Flash Freeze", "desc": "Hit 4 enemies with one Frost Nova", "xp": 500}, {"name": "Absolute", "desc": "Get 2 kills during one Absolute Zero", "xp": 700}], "br": [{"name": "Glacier", "desc": "Lock them in place", "n": [{"name": "Biting Cold", "desc": "Frostbite freezes at 4 stacks instead of 5"}, {"name": "Thick Ice", "desc": "+40% Glacial Wall duration"}, {"name": "Great Wall", "desc": "+40% Glacial Wall width"}, {"name": "Frozen Solid", "desc": "Full freezes last 50% longer"}, {"name": "Ice Prison", "desc": "CAPSTONE: Frost Nova encases enemies in a shell of ice"}]}, {"name": "Shardcaster", "desc": "Cold steel", "n": [{"name": "Sharper Shards", "desc": "+25% Ice Shard damage"}, {"name": "Splinter", "desc": "Ice Shard shatters into fragments on impact"}, {"name": "Piercing Cold", "desc": "Ice Shard pierces 2 more enemies"}, {"name": "Cold Snap", "desc": "+30% Frost Nova damage"}, {"name": "Hailstorm", "desc": "CAPSTONE: Ice Shard fires a fan of three shards"}]}, {"name": "Winter's Heart", "desc": "Endure the cold", "n": [{"name": "Frost Armor", "desc": "Enemies that hit you in melee are slowed"}, {"name": "Chilled Blood", "desc": "Take 10% less damage from slowed enemies"}, {"name": "Long Winter", "desc": "+30% Absolute Zero duration"}, {"name": "Wider Storm", "desc": "+25% Absolute Zero radius"}, {"name": "Heart of Winter", "desc": "CAPSTONE: inside Absolute Zero you regenerate and cannot be slowed"}]}]}, "storm": {"title": "Storm", "color": "#4FA8FF", "lore": "Thunder trapped in a chamber of glass, begging to be let out.", "i": 6, "a": [{"name": "Lightning Strike", "desc": "A sigil crackles under your target, then the sky answers. The bolt snaps onto them if they have not got clear.", "var": "Level: a telegraphed bolt on your aim (30 blocks). Up: Stormcall, the bolt strikes you and bursts out as a nova of lightning. Down: Ground Current, lightning races along the floor ahead, rooting everyone it touches.", "cd": 10, "unlock": 0}, {"name": "Gale Burst", "desc": "Blast every enemy away and ride the updraft into the sky.", "var": "Level: a ring of wind that throws everyone back while you soar. Up: Updraft Column, a telegraphed geyser at your aim hurls them skyward (mind the fall). Down: Downburst, a crushing wind slams everyone around you into the ground and pins them.", "cd": 18, "unlock": 10}, {"name": "Chain Lightning", "desc": "A bolt that leaps from enemy to enemy, weaker with every jump.", "var": "Level: 5 jumps (7 with Conductor). Up: Ball Lightning, a slow orb that lashes everything near it and bursts into a chain. Down: Arc Snare, tether everyone around you; whoever strays more than 7 blocks is struck hard and dragged back.", "cd": 24, "unlock": 40}, {"name": "Tempest", "desc": "Become the storm. A thundercloud follows you and every second marks up to three enemies for falling bolts.", "var": "Level: the Tempest follows you for 10 seconds. Up: Eye of the Storm, a vortex anchored where you stand drags enemies in under faster bolts. Down: Supercell, root yourself for 1.5 seconds while the sky winds up, then five bolts and one cataclysmic blast.", "cd": 130, "unlock": 75}], "p1": "Stormborn", "p1d": "Lightning runs straight through you. You move 20% faster in the rain.", "p2": "Static", "p2d": "Every 4th melee hit arcs a spark to another enemy (the meter shows the charge).", "aw": "Thunder God", "awd": "Lightning Strike leaves charged ground that shocks and slows for 2 seconds.", "feats": [{"name": "Skyfall", "desc": "Hit an airborne enemy with Lightning Strike", "xp": 300}, {"name": "Overcharge", "desc": "Hit 5 enemies with one Chain Lightning", "xp": 500}, {"name": "Blown Away", "desc": "Knock back 4 enemies with one Gale Burst", "xp": 400}, {"name": "Eye of the Storm", "desc": "Land 15 Tempest bolts in one Tempest", "xp": 600}], "br": [{"name": "Conduit", "desc": "More voltage", "n": [{"name": "High Voltage", "desc": "+20% Lightning Strike damage"}, {"name": "Forked Bolt", "desc": "Lightning Strike also hits the nearest other enemy"}, {"name": "Conductor", "desc": "Chain Lightning bounces 2 more times"}, {"name": "Overload", "desc": "Static triggers on every 3rd hit"}, {"name": "Thunderstorm", "desc": "CAPSTONE: Lightning Strike calls three bolts marching forward"}]}, {"name": "Windcaller", "desc": "The air obeys", "n": [{"name": "Strong Gust", "desc": "+30% Gale Burst knockback"}, {"name": "Updraft", "desc": "Gale Burst lifts you higher and you float down longer"}, {"name": "Wind Wall", "desc": "After Gale Burst, a ring of wind deflects projectiles for 3 seconds"}, {"name": "Tailwind", "desc": "Your rain speed bonus applies in any weather"}, {"name": "Cyclone", "desc": "CAPSTONE: Gale Burst becomes a cyclone that lifts enemies, spins them, then flings them"}]}, {"name": "Tempest", "desc": "Be the weather", "n": [{"name": "Rolling Thunder", "desc": "+30% Tempest duration"}, {"name": "Wide Storm", "desc": "+25% Tempest radius"}, {"name": "Static Field", "desc": "During Tempest, enemies that hit you are shocked"}, {"name": "Ionized", "desc": "Your lightning ionizes targets: +15% ability damage against them for 4s"}, {"name": "Ride the Lightning", "desc": "CAPSTONE: you can fly while Tempest lasts"}]}]}, "blood": {"title": "Blood", "color": "#9E0B1F", "lore": "It hungers. Every wound you deal feeds it, and you.", "i": 7, "a": [{"name": "Blood Spike", "desc": "Hurl a spike of blood: 6 damage, a 3 s bleed, and you drink 2 health. At 100 Vitae it becomes a huge piercing Hemorrhage Lance.", "var": "Level: thrown spike (three with Spike Volley). Up: Crimson Rain, a circle where you look rains spikes three times after a warning. Down: Blood Thorns, a line of thorns bursts from the ground ahead, rooting and bleeding what it skewers.", "cd": 8, "unlock": 0}, {"name": "Crimson Pact", "desc": "Pay 2 hearts of your own blood for power.", "var": "Level: Pact of Power, Strength II for 8 s. Up: Blood Ward, 4 hearts of absorption and everyone who hits you is lashed and bleeds. Down: Sanguine Nova, your heart swells (a ring warns) then bursts for 5 damage and a bleed around you, and you drink from every wound.", "cd": 20, "unlock": 10}, {"name": "Siphon", "desc": "Tether an enemy and drink 1.5 health every half second for 4 s. Break line of sight or get 14 blocks away to snap it.", "var": "Level: the tether (the enemy you look at, or the nearest). Up: Blood Hook, rip the target to you: 4 damage, a bleed and Slowness. Down: Exsanguinate, every enemy bleeding from you within 12 bursts for its remaining bleed at once, and you drink half.", "cd": 26, "unlock": 40}, {"name": "Blood Moon", "desc": "The moon bleeds for 12 s: Strength I, at least 40% lifesteal, and every enemy within 10 bleeds.", "var": "Level: the moon rises over you and follows you. Up: Crimson Eclipse, the moon stays where you cast it, 14 blocks wide; enemies inside bleed in darkness, and you drink deeply only inside. Down: Moonfall, a shadow marks where you look, the moon crashes there (10 damage, 6 s bleed), then a 6 s Blood Moon rises over you.", "cd": 140, "unlock": 75}], "p1": "Lifesteal", "p1d": "Heal 10% of the melee damage you deal, swallowed in 2-heart gulps. Healing fills Vitae, the meter under your abilities.", "p2": "Hemorrhage", "p2d": "Critical hits make enemies bleed for 4 seconds (1 damage a second).", "aw": "Sanguine Lord", "awd": "Healing beyond full health becomes absorption (2 hearts).", "feats": [{"name": "Insatiable", "desc": "Heal 500 health with the Blood Heart", "xp": 500}, {"name": "Exsanguinate", "desc": "Kill 10 enemies while they bleed", "xp": 400}, {"name": "Blood Price", "desc": "Kill a player during Crimson Pact while below 4 hearts", "xp": 600}, {"name": "Feast", "desc": "Heal 20 health during one Blood Moon", "xp": 600}], "br": [{"name": "Vampire", "desc": "Never stop drinking", "n": [{"name": "Thirst", "desc": "+50% lifesteal"}, {"name": "Long Draw", "desc": "+40% Siphon duration"}, {"name": "Night Feeder", "desc": "Lifesteal doubles at night"}, {"name": "Bloodbank", "desc": "Siphon healing beyond full health becomes absorption"}, {"name": "Undeath", "desc": "CAPSTONE: Siphon drains every enemy near you at once"}]}, {"name": "Hemomancer", "desc": "Open every vein", "n": [{"name": "Deep Cuts", "desc": "Bleeding lasts 50% longer"}, {"name": "Spike Volley", "desc": "Blood Spike throws three spikes"}, {"name": "Open Veins", "desc": "Bleeding enemies take 10% more damage from you"}, {"name": "Blood Rain", "desc": "+50% Blood Moon bleed damage"}, {"name": "Hemorrhagic Burst", "desc": "CAPSTONE: bleeding enemies burst when they die, making everyone near them bleed"}]}, {"name": "Berserker", "desc": "Pay any price", "n": [{"name": "Cheap Price", "desc": "Crimson Pact costs 1 heart instead of 2"}, {"name": "Blood Frenzy", "desc": "+40% Crimson Pact duration"}, {"name": "Pain Tolerance", "desc": "Take 10% less damage below half health"}, {"name": "Red Haste", "desc": "Crimson Pact also grants Speed II and Haste II"}, {"name": "Martyr", "desc": "CAPSTONE: killing a player resets Crimson Pact"}]}]}, "titan": {"title": "Titan", "color": "#C9A45C", "lore": "The heart of a mountain. Unmoving, unbreakable, enormous.", "i": 8, "a": [{"name": "Ground Slam", "desc": "Slam the earth and send a fault line ripping forward: slabs erupt along it, damaging and launching what they hit. Hits build Tremor; at full Tremor your next slam is a Cataclysm.", "var": "Level: a fault line tears 12 blocks ahead (three lines with Tectonic). Up: Skybreaker, leap high, a ring marks your landing, then dive and crater the ground around you. Down: Epicenter, three expanding shockwave rings burst out from where you stand.", "cd": 10, "unlock": 0}, {"name": "Stone Skin", "desc": "Turn your skin to stone: Resistance II and immunity to knockback for 5 s, with stone shards orbiting you.", "var": "Level: Stone Skin (it slows you unless you have Unshakable). Up: Obsidian Shell, Resistance IV but rooted for 2.5 s, then the shell bursts outward harder the more damage it absorbed. Down: Rockbind, stone hands burst from the ground and stun every enemy within 6 blocks.", "cd": 24, "unlock": 10}, {"name": "Boulder Toss", "desc": "Tear a boulder out of the ground, lift it overhead and hurl it in an arc: 8 damage in a blast where it lands.", "var": "Level: one arcing boulder (three with World Breaker). Up: Meteor Lob, a warning marks the nearest enemy's spot, then a boulder drops from the sky onto it. Down: Shrapnel, the boulder bursts in your hands into a fan of stone shards ahead.", "cd": 22, "unlock": 40}, {"name": "Colossus", "desc": "Grow to giant size for 12 s: more health and reach, and every melee blow sends a shockwave.", "var": "Level: you swell over a second into a Colossus. Up: Titanfall, leap and crash down, then rise as a Colossus. Down: Bastion, root yourself as a bigger fortress with 10 extra hearts, the ground quaking around you every 1.5 s.", "cd": 150, "unlock": 75}], "p1": "Mountain's Endurance", "p1d": "+2 hearts of maximum health and 30% knockback resistance. Taking and dealing hits builds Tremor, the meter under your abilities.", "p2": "Bulwark", "p2d": "Below half health your stone hardens: +4 armor and +2 armor toughness.", "aw": "Mountain", "awd": "+1 more heart, a stone crown, and Colossus grows you to twice your size.", "feats": [{"name": "Fault Line", "desc": "Hit 3 enemies with one Ground Slam", "xp": 400}, {"name": "Catapult", "desc": "Hit an enemy with a boulder thrown from 20 or more blocks", "xp": 400}, {"name": "Immovable", "desc": "Shrug off 200 damage with Stone Skin", "xp": 500}, {"name": "Giant's Wrath", "desc": "Get 3 kills during one Colossus", "xp": 700}], "br": [{"name": "Earthshaker", "desc": "Break the ground", "n": [{"name": "Deep Tremor", "desc": "+25% Ground Slam damage"}, {"name": "Long Fault", "desc": "+40% Ground Slam length"}, {"name": "Aftershock", "desc": "Ground Slam erupts again a second later for half damage"}, {"name": "Quake Step", "desc": "As a Colossus, your footsteps damage nearby enemies"}, {"name": "Tectonic", "desc": "CAPSTONE: Ground Slam splits into three fault lines"}]}, {"name": "Bastion", "desc": "Be the wall", "n": [{"name": "Granite", "desc": "+1 more heart of maximum health"}, {"name": "Enduring Stone", "desc": "+40% Stone Skin duration"}, {"name": "Spiked Stone", "desc": "Attackers take 2 damage while Stone Skin is active"}, {"name": "Unshakable", "desc": "Stone Skin no longer slows you"}, {"name": "Living Fortress", "desc": "CAPSTONE: Stone Skin also shields teammates near you"}]}, {"name": "Juggernaut", "desc": "Throw mountains", "n": [{"name": "Heavy Rock", "desc": "+30% Boulder Toss damage"}, {"name": "Bigger Rock", "desc": "+40% Boulder blast radius"}, {"name": "Towering", "desc": "+30% Colossus duration"}, {"name": "Titanic Reach", "desc": "Colossus gives 1.5 more blocks of reach"}, {"name": "World Breaker", "desc": "CAPSTONE: Boulder Toss throws three boulders"}]}]}, "celestial": {"title": "Celestial", "color": "#FFF2B0", "lore": "A fallen star that still remembers the sky.", "i": 9, "a": [{"name": "Starfall", "desc": "A sigil marks your target, then a star falls from the sky onto it and explodes. Starlight fills over time, faster under the night sky; at full Starlight your next Starfall or Beam is Exalted.", "var": "Level: one star where you look (with two smaller ones on Meteor Shower). Up: Starstorm, six stars rain in a ring around the nearest enemy. Down: Nova Star, a star crashes onto you, blasting enemies away and shielding you with absorption.", "cd": 9, "unlock": 0}, {"name": "Sanctuary", "desc": "Consecrate the ground: allies inside heal and enemies inside are weakened.", "var": "Level: a glowing circle at your feet. Up: Aegis, a dome of light that heals you and throws enemies out of it. Down: Judgement, holy ground that burns enemies every second and detonates when it ends.", "cd": 28, "unlock": 10}, {"name": "Radiant Beam", "desc": "Gather light, then fire a lance that pierces everything in a 28-block line.", "var": "Level: one beam (it splits in three with Prism). Up: Dawnbreaker, channel a sweeping beam for 2.5 s that you aim as you move. Down: Prism Nova, guide lines flash, then eight beams fire out around you.", "cd": 22, "unlock": 40}, {"name": "Ascension", "desc": "Rise into the air, shielded by light (Resistance III), as stars rain on your foes for 8 s. Light wings spread behind you.", "var": "Level: hover while stars strike enemies near you. Up: Zenith, the stars fall wherever you look. Down: Avatar, stay grounded and heal as rings of six stars fall around you.", "cd": 150, "unlock": 75}], "p1": "Starlit", "p1d": "Permanent Night Vision. Regeneration I while standing in sunlight under the open sky.", "p2": "Radiance", "p2d": "Your abilities deal +25% damage to undead and your strikes set them alight. Every 4 seconds nearby teammates are healed.", "aw": "Supernova", "awd": "A halo crowns you, and Ascension ends in a blinding supernova.", "feats": [{"name": "Shooting Star", "desc": "Hit an airborne enemy with Starfall", "xp": 300}, {"name": "Haven", "desc": "Recover 40 health inside your Sanctuaries", "xp": 400}, {"name": "Lance of Light", "desc": "Hit 3 enemies with one Radiant Beam", "xp": 500}, {"name": "Heaven's Wrath", "desc": "Land 10 star hits in one Ascension", "xp": 700}], "br": [{"name": "Astromancer", "desc": "Pull down the heavens", "n": [{"name": "Heavier Stars", "desc": "+25% Starfall damage"}, {"name": "Meteor Shower", "desc": "Starfall brings two smaller stars with it"}, {"name": "Starburn", "desc": "Starfall slows what it hits"}, {"name": "Constellation", "desc": "Starfall recharges 25% faster"}, {"name": "Comet", "desc": "CAPSTONE: Starfall becomes a comet with twice the blast and heavy knockback"}]}, {"name": "Seraph", "desc": "Shelter the faithful", "n": [{"name": "Wider Sanctuary", "desc": "+30% Sanctuary radius"}, {"name": "Blessed Ground", "desc": "Sanctuary also grants Resistance I"}, {"name": "Lasting Light", "desc": "+40% Sanctuary duration"}, {"name": "Guardian Angel", "desc": "Radiance pulses heal twice as much and include you"}, {"name": "Divine Intervention", "desc": "CAPSTONE: Sanctuary purges harmful effects from allies inside it"}]}, {"name": "Radiant", "desc": "Burn with light", "n": [{"name": "Focused Light", "desc": "+25% Radiant Beam damage"}, {"name": "Prism", "desc": "The beam splits into two more beams at the first enemy it hits"}, {"name": "Searing Light", "desc": "Radiant Beam briefly blinds players"}, {"name": "Dawn", "desc": "+30% Ascension duration"}, {"name": "Judgment", "desc": "CAPSTONE: during Ascension, pillars of light strike instead of stars, hitting everything near the target"}]}]}, "corruption": {"title": "Corruption", "color": "#7BD13A", "lore": "Rot that thinks. It spreads from host to host.", "i": 10, "a": [{"name": "Plague Bolt", "desc": "A bolt of rot that bursts into a lingering poison cloud. At 100 Contagion it becomes a Pestilence Bolt (+60% damage, wider cloud, Wither II).", "var": "Level: a fast bolt that bursts into a plague cloud. Up: a lobbed plague mortar that arcs down into a bigger cloud with a splash of damage. Down: spew a 7-block cone of bile at point-blank range - damage, Poison II and a shove.", "cd": 9, "unlock": 0}, {"name": "Rot Ground", "desc": "Corrupt the earth: everything standing on it withers and slows.", "var": "Level: rot spreads where you look. Up: the rot blooms around you and follows you, mending you while you stand in it. Down: a sinking mire at your feet; after a 1 s windup grasping roots erupt, rooting and tearing everything on it.", "cd": 22, "unlock": 10}, {"name": "Infest", "desc": "Plant an infection in a target. It bursts after a few seconds with a quickening heartbeat, poisoning everything near.", "var": "Level: infest the target you look at. Up: infest yourself - a double-size burst you are immune to, Resistance and Speed until it goes off, and healing per victim. Down: a leeching infection tethered to you that drains the host each second; break the 14-block tether and it bursts early.", "cd": 30, "unlock": 40}, {"name": "Pandemic", "desc": "Spread the plague to everything around you and raise Rotlings that hunt your enemies.", "var": "Level: Outbreak - every enemy within 15 blocks is infested and Rotlings claw out around you. Up: Plague Storm - a rotting cloud rains telegraphed plague globs on your enemies for 8 s. Down: Mass Grave - after a 1 s windup the dead erupt beneath your enemies, rooting them, and rise as Rotlings.", "cd": 150, "unlock": 75}], "p1": "Plagueborn", "p1d": "Immune to Poison and Wither. Hits and plague fill the Contagion meter; at 100 your next Plague Bolt is a Pestilence Bolt.", "p2": "Blight", "p2d": "Melee hits poison; the third hit on the same enemy within 5 s makes it Poison II.", "aw": "Blight Lord", "awd": "If an infested target dies before it bursts, the infection leaps to the nearest enemy.", "feats": [{"name": "Patient Zero", "desc": "Poison 5 enemies with one Plague Bolt cloud", "xp": 400}, {"name": "Decomposition", "desc": "Kill 10 enemies standing in your Rot Ground", "xp": 400}, {"name": "Contagion", "desc": "Hit 3 enemies with one Infest burst", "xp": 500}, {"name": "Outbreak", "desc": "Infect 5 enemies with one Pandemic", "xp": 800}], "br": [{"name": "Plaguebringer", "desc": "Fill the air with rot", "n": [{"name": "Virulent", "desc": "+25% Plague Bolt damage"}, {"name": "Spreading Cloud", "desc": "+40% plague cloud radius"}, {"name": "Lingering Miasma", "desc": "Plague clouds last 50% longer"}, {"name": "Necrosis", "desc": "Poisoned enemies take 15% more damage from your abilities"}, {"name": "Plague Rain", "desc": "CAPSTONE: Plague Bolt bursts into four bolts that rain around the impact"}]}, {"name": "Rotmother", "desc": "The dead serve", "n": [{"name": "Deep Rot", "desc": "+30% Rot Ground radius"}, {"name": "Withering", "desc": "Rot Ground inflicts Wither II"}, {"name": "Sticky Mire", "desc": "Rot Ground slows enemies more"}, {"name": "Brood", "desc": "Pandemic raises 2 more Rotlings"}, {"name": "Hive Mind", "desc": "CAPSTONE: Rotlings last 50% longer and burst into plague clouds when they fall"}]}, {"name": "Contagion", "desc": "It spreads", "n": [{"name": "Short Fuse", "desc": "Infest bursts a second sooner"}, {"name": "Bigger Burst", "desc": "+40% Infest burst radius"}, {"name": "Feverish", "desc": "Blight becomes Poison II after 2 hits instead of 3"}, {"name": "Carrier", "desc": "When Infest bursts, it jumps to the nearest enemy"}, {"name": "Black Death", "desc": "CAPSTONE: every enemy hit by an Infest burst becomes infested too"}]}]}}
