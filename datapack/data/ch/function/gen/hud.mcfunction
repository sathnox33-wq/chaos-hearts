execute if score @s ch.active matches 4 run function ch:kit/void/hud
execute if score @s ch.active matches 5 run function ch:kit/frozen/hud
execute if score @s ch.active matches 6 run function ch:kit/storm/hud
execute if score @s ch.active matches 7 run function ch:kit/blood/hud
execute if score @s ch.active matches 8 run function ch:kit/titan/hud
execute if score @s ch.active matches 9 run function ch:kit/celestial/hud
execute if score @s ch.active matches 10 run function ch:kit/corruption/hud
