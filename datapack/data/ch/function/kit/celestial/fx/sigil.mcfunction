# A persistent ground sigil: model $(model), tint $(color), grows to scale $(s) and spins ($(tag)) for $(life) ticks.
$execute summon item_display run data merge entity @s {Tags:["ch.fx","ch.noability","ch.celestial.gnew","ch.celestial.spin","$(tag)"],brightness:{sky:15,block:15},view_range:4.0f,interpolation_duration:8,item_display:"none",item:{id:"minecraft:paper",count:1,components:{"minecraft:item_model":"chaoshearts:fx/$(model)","minecraft:custom_model_data":{colors:[$(color)]},"minecraft:custom_data":{sc:[$(s)f,$(s)f,$(s)f]}}},transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.1f,0.1f,0.1f]}}
$execute as @e[type=item_display,tag=ch.celestial.gnew,distance=..0.05] unless score @s ch.life matches 1.. run function ch:kit/celestial/fx/sigil_init {life:$(life)}
