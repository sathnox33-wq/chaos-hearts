# Op: lists the admin commands.
tellraw @s [{text:"\n◉ Chaos Hearts admin\n",color:"light_purple",bold:true},{text:"[Open the admin panel]",color:"aqua",underlined:true,click_event:{action:"run_command",command:"/function ch:admin"}},{text:"  /function ch:admin, then /trigger chadmin\n",color:"gray"},{text:"Give admin to someone else: /tag <name> add ch.admin\n\n",color:"dark_gray"},{text:"Typed commands (player can be a name, @s or any selector):\n",color:"gray"},{text:"/function ch:admin/give {player:\"@s\",heart:\"rage\"}\n",color:"white"},{text:"/function ch:admin/take {player:\"@s\",heart:\"rage\"}\n",color:"white"},{text:"/function ch:admin/mastery {player:\"@s\",heart:\"rage\",level:100}\n",color:"white"},{text:"/function ch:admin/awaken {player:\"@s\",heart:\"rage\"}\n",color:"white"},{text:"/function ch:admin/altar/place",color:"white"},{text:"  build an Awakening Altar here (remove: ch:admin/altar/remove)\n",color:"gray"},{text:"/function ch:admin/list",color:"white"},{text:"  every heart on the server\n",color:"gray"},{text:"/function ch:eye/on",color:"white"},{text:"  become the Eye (ch:eye/off, ch:eye/panel)\n",color:"gray"},{text:"Settings: the panel's Settings page, or /scoreboard players set #<name> ch.cfg <value>. Reset: /function ch:gen/config_reset",color:"dark_gray"}]
